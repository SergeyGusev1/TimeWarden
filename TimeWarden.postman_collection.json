{
  "info": {
    "name": "TimeWarden API",
    "description": "REST API для трекера активности TimeWarden.\n\nУстановите переменную `base_url` = `http://localhost:8000/api/v1` перед запросом.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "activity_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Activities",
      "item": [
        {
          "name": "Создать активность",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has id', () => pm.expect(json).to.have.property('id'));",
                  "pm.test('Has app_name', () => pm.expect(json.app_name).to.be.a('string'));",
                  "pm.collectionVariables.set('activity_id', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/activity",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"app_name\": \"Visual Studio Code\",\n  \"window_title\": \"main.py — TimeWarden\",\n  \"category\": \"productive\",\n  \"duration_seconds\": 3600,\n  \"start_time\": \"2024-01-15T10:00:00\",\n  \"end_time\": \"2024-01-15T11:00:00\"\n}"
            },
            "description": "Создать запись об активности (вызывается агентом)."
          }
        },
        {
          "name": "Получить список активностей",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has items', () => pm.expect(json).to.have.property('items'));",
                  "pm.test('Has total', () => pm.expect(json).to.have.property('total'));",
                  "pm.test('Has page', () => pm.expect(json.page).to.eql(1));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/activity?page=1&size=10",
              "host": ["{{base_url}}"],
              "path": ["activity"],
              "query": [
                { "key": "page", "value": "1", "description": "Номер страницы (от 1)" },
                { "key": "size", "value": "10", "description": "Размер страницы" }
              ]
            },
            "description": "Список активностей с пагинацией."
          }
        },
        {
          "name": "Получить активность по ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has id', () => pm.expect(pm.response.json()).to.have.property('id'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/activity/{{activity_id}}",
            "description": "Получить одну запись по id. ID подставляется автоматически из теста создания."
          }
        },
        {
          "name": "Активность не найдена (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/activity/99999",
            "description": "Несуществующий ID → 404."
          }
        }
      ]
    },
    {
      "name": "Stats",
      "item": [
        {
          "name": "Статистика по категориям",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has categories', () => pm.expect(json).to.have.property('categories'));",
                  "pm.test('Has total_seconds', () => pm.expect(json).to.have.property('total_seconds'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stats/categories",
              "host": ["{{base_url}}"],
              "path": ["stats", "categories"],
              "query": [
                { "key": "start_date", "value": "2024-01-01", "description": "Начало периода (YYYY-MM-DD)", "disabled": true },
                { "key": "end_date",   "value": "2024-01-31", "description": "Конец периода (YYYY-MM-DD)",  "disabled": true }
              ]
            },
            "description": "Распределение времени по категориям. Без дат — за всё время."
          }
        },
        {
          "name": "Статистика по дням",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stats/daily?days=7",
              "host": ["{{base_url}}"],
              "path": ["stats", "daily"],
              "query": [
                { "key": "days", "value": "7", "description": "Количество дней (1–30)" }
              ]
            },
            "description": "Активность по дням за последние N дней."
          }
        },
        {
          "name": "Статистика по дням — 30 дней",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stats/daily?days=30",
              "host": ["{{base_url}}"],
              "path": ["stats", "daily"],
              "query": [
                { "key": "days", "value": "30" }
              ]
            }
          }
        },
        {
          "name": "Топ приложений",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stats/top-apps?limit=10",
              "host": ["{{base_url}}"],
              "path": ["stats", "top-apps"],
              "query": [
                { "key": "limit",    "value": "10",         "description": "Сколько приложений вернуть (1–50)" },
                { "key": "category", "value": "productive", "description": "Фильтр по категории", "disabled": true }
              ]
            },
            "description": "Топ приложений по суммарному времени."
          }
        },
        {
          "name": "Топ приложений — только продуктивные",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stats/top-apps?limit=10&category=productive",
              "host": ["{{base_url}}"],
              "path": ["stats", "top-apps"],
              "query": [
                { "key": "limit",    "value": "10" },
                { "key": "category", "value": "productive" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Docs (Swagger)",
          "request": {
            "method": "GET",
            "url": "http://localhost:8000/docs",
            "description": "Открыть интерактивную документацию FastAPI."
          }
        },
        {
          "name": "OpenAPI JSON",
          "request": {
            "method": "GET",
            "url": "http://localhost:8000/openapi.json",
            "description": "Схема OpenAPI в формате JSON."
          }
        }
      ]
    }
  ]
}
